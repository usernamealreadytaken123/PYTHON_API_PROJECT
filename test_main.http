@baseUrl = http://127.0.0.1:8000
@userId = 1

### 0. Health check
GET {{baseUrl}}/
Accept: application/json

### 1. Current weather by coordinates
GET {{baseUrl}}/weather/current?lat=55.7558&lon=37.6173
Accept: application/json

### 2. Add city, base mode without user_id
POST {{baseUrl}}/cities
Content-Type: application/json

{
  "name": "Paris",
  "latitude": 48.8566,
  "longitude": 2.3522
}

### 3. List cities, base mode
GET {{baseUrl}}/cities
Accept: application/json

### 4. City weather at selected time, all fields, base mode
GET {{baseUrl}}/cities/Paris/weather?time=18:00
Accept: application/json

### 5. City weather at selected time, selected fields, base mode
GET {{baseUrl}}/cities/Paris/weather?time=18:00&fields=temperature,wind_speed
Accept: application/json

### 6. Register user, optional extra task
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Artem"
}

### 7. Add city for user, optional extra task
### If the registered user id is not 1, change @userId at the top of this file.
POST {{baseUrl}}/cities?user_id={{userId}}
Content-Type: application/json

{
  "name": "Tomsk",
  "latitude": 56.4846,
  "longitude": 84.9476
}

### 8. List cities for user, optional extra task
GET {{baseUrl}}/cities?user_id={{userId}}
Accept: application/json

### 9. City weather for user, optional extra task
GET {{baseUrl}}/cities/Tomsk/weather?user_id={{userId}}&time=18:00&fields=temperature,humidity,wind_speed,precipitation
Accept: application/json
